{
  "name": "smartqueue-enterprise",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered mobile self-checkout ecosystem",
  "scripts": {
    "dev": "pnpm --parallel --filter smartqueue-backend --filter portal-web --filter smartqueue-admin dev",
    "backend": "pnpm --filter smartqueue-backend dev",
    "admin": "pnpm --filter smartqueue-admin dev",
    "portal": "pnpm --filter portal-web dev",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "install:all": "pnpm install",
    "patch": "node scripts/postinstall.js"
  },
  "workspaces": [
    "backend",
    "admin-dashboard",
    "customer-mobile",
    "worker-mobile",
    "shared",
    "portal-web"
  ],
  "overrides": {
    "webpack": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@scarf/scarf",
      "esbuild",
      "esbuild-wasm",
      "@swc/core"
    ]
  }
}
